// nextflow.config — single config for the whole end-to-end pipeline
// (FastQC -> Trim Galore -> STAR -> featureCounts -> MultiQC -> DESeq2/PCA)
//
// install rnaseq-pipeline-env.yml before the first real run.

params.conda_env = null   // optional absolute path to the conda env; default: $CONDA_PREFIX

process {
    executor = 'slurm'

    // Default Slurm partition — 'medium', 'fat', 'gpu' available on this
    // cluster. Per-process labels below route heavy steps (STAR) to 'fat'.
    queue  = 'medium'
    cpus   = 1
    memory = '2 GB'
    time   = '24h'

    errorStrategy = 'retry'
    maxRetries    = 1

    // Single shared env for every process, no per-process containers.
    // Resolved from the activated env (`conda activate rnaseq-pipeline`), so no
    // user-specific path is hardcoded. Override with --conda_env /path/to/env
    // (or conda_env in a params file) if running without an activated env.
    conda = params.conda_env ?: System.getenv('CONDA_PREFIX')

    withLabel: process_high {
        queue  = 'fat'
        cpus   = 8
        memory = '64 GB'
        time   = '24h'
    }

    withLabel: process_high_memory {
        queue  = 'fat'
        cpus   = 8
        memory = '128 GB'
        time   = '24h'
    }

    withLabel: process_long {
        queue  = 'fat'
        cpus   = 4
        memory = '32 GB'
        time   = '48h'
    }

    // Kept for parity unused by this pipeline.
    withLabel: process_gpu {
        queue  = 'gpu'
        cpus   = 4
        memory = '32 GB'
        time   = '12h'
    }

    // Per-process resource overrides for our actual steps.
    withName: FASTQC_RAW {
        cpus   = 2
        memory = '4 GB'
        time   = '2h'
    }

    withName: TRIM_GALORE {
        cpus   = 4
        memory = '8 GB'
        time   = '6h'
    }

    // STAR_INDEX and STAR_ALIGN are tagged with label 'process_high' in
    // rnaseq_pipeline.nf, so they pick up the 'fat' queue / 64 GB / 8 cpu settings
    // above automatically so no separate withName block needed for those.

    withName: FEATURECOUNTS {
        cpus   = 4
        memory = '16 GB'
        time   = '4h'
    }

    withName: MULTIQC {
        cpus   = 1
        memory = '4 GB'
        time   = '1h'
    }

    withName: PCA_DESEQ2 {
        cpus   = 2
        memory = '16 GB'
        time   = '4h'
    }

    withName: ENRICHMENT {
	cpus   = 4
	memory = '16 GB'
	time   = '6h'
   }
}

executor {
    // Kept for parity with moderate submission pressure on the
    // scheduler even now that we're submitting more, smaller jobs.
    queueSize         = 10
    submitRateLimit   = '5/1min'
    pollInterval      = '2 min'
    queueStatInterval = '5 min'
}

conda {
    enabled = true
    useMamba = true
}

// No container backend anywhere in this pipeline.
singularity {
    enabled = false
}

env {
    PYTHONNOUSERSITE     = 1
    OMP_NUM_THREADS      = 1
    OPENBLAS_NUM_THREADS = 1
}
