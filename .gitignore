# ============================================================================
# mycoPCLS_analysis — .gitignore
# Tracked on purpose (do NOT ignore): metadata_*.csv, samplesheet_*.csv,
# params_*.yaml, nextflow.config, rnaseq_pipeline.nf, rnaseq-pipeline-env.yml,
# bin/, helpeR_scripts/, README.md
# ============================================================================

# --- Nextflow runtime artefacts ---
.nextflow/
.nextflow.log*
.nextflow.pid
work/
timeline*.html
report*.html
trace*.txt
dag*.html
dag*.png
dag*.svg
dag*.pdf

# --- Pipeline outputs ---
results/
results_*/

# --- Reference data and annotation caches (genomes, GTFs, STAR indices, cache) ---
ref/
annotation_cache*/

# --- Large sequencing / reference files (never commit) ---
*.fastq
*.fastq.gz
*.fq
*.fq.gz
*.bam
*.bai
*.sam
*.cram
*.fa
*.fa.gz
*.fasta
*.fasta.gz
*.gtf
*.gtf.gz

# --- Generated by helpeR_scripts (regenerable) ---
failed_biomart_ids_*.txt

# --- R ---
.Rhistory
.RData
.Rapp.history
.Rproj.user/
.Ruserdata
*.Rout
Rplots.pdf

# --- Slurm ---
slurm-*.out

# --- Editor / OS ---
.DS_Store
Thumbs.db
*.swp
*~
.vscode/
.idea/
